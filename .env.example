# -----------------------------------------------------------------------------
# Workhorse Environment Configuration Template
# -----------------------------------------------------------------------------

# Local Ollama Host (default: http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=z-ai/glm-5.3-prime

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Groq Cloud LPUs
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# APMix Gateway
APMIX_API_KEY=your_apmix_api_key_here
APMIX_BASE_URL=https://api.apmix.ai/v1
APMIX_MODEL=claude-sonnet-4-6-free

# Nvidia NIM
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
NVIDIA_VISION_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# Research & Observability Services
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
JINA_API_KEY=your_jina_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here
YOU_API_KEY=your_you_api_key_here

# Langfuse Telemetry
ENABLE_LANGFUSE_TRACING=false
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_BASEURL=https://cloud.langfuse.com

# PyPI Publishing Key (Manual Release only)
PYPI_PUBLISH_KEY=
